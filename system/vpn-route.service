[Unit]
Description=VPN Route Management Service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# All site config (interfaces, DIRECT_DOMAINS, CAKE) lives in the env file.
EnvironmentFile=-/etc/default/vpn-route
ExecStart=/usr/local/bin/vpn-route.sh
Restart=on-failure
RestartSec=10s 
StartLimitInterval=1min
StartLimitBurst=10
LogLevelMax=1
SyslogLevel=2  

[Install]
WantedBy=multi-user.target
