UID=1000
GID=1000

PSIPHON_EGRESS_REGION=

MACVLAN_PARENT=eth0

NAIVE_SERVER=
NAIVE_USER=
NAIVE_PASSWORD=

FRP_PROXY_VERSION=v0.66.0
FRP_PROXY_SERVER_ADDR=
FRP_PROXY_AUTH_TOKEN=
FRP_PROXY_VISITOR_SK=

# GooseRelayVPN client pinned version
GOOSE_VERSION=v1.7.1

# SNI-spoofing client pinned version
SNI_SPOOFING_VERSION=0.5.1

BYEDPI_VERSION=v0.17.3
# byedpi desync args
BYEDPI_DESYNC=-s 1:5:3+s

SKIRK_VERSION=latest
# Paste the one-line `skirk:...` client profile from your exit node below.
SKIRK_CLIENT_CONFIG=
# Google Drive poll interval (ms): lower = snappier but more Drive ops.
SKIRK_POLL_MS=1000
# Skirk's "upload/download workers" = Drive concurrency. Leave 0 to let
# Skirk auto-profile (its "Recommended" 8 upload / 16 download).
SKIRK_UPLOAD_CONCURRENCY=0
SKIRK_DOWNLOAD_CONCURRENCY=0

PRIVATE_DNS_STAMP=

MDNS_VERSION=latest
MDNS_DOMAIN=
MDNS_ENCRYPTION_KEY=
# Encryption: 0=None, 1=XOR, 2=ChaCha20, 3=AES-128-GCM, 4=AES-192-GCM, 5=AES-256-GCM
MDNS_DATA_ENCRYPTION_METHOD=1
# MTU bounds the client searches between when probing each resolver.
# Lower = more resolvers pass / slower throughput. Higher = faster / more drops.
# Sample defaults are biased toward lossy/high-latency links (this is a last-resort tunnel).
MDNS_MIN_UPLOAD_MTU=38
MDNS_MAX_UPLOAD_MTU=150
MDNS_MIN_DOWNLOAD_MTU=200
MDNS_MAX_DOWNLOAD_MTU=4000

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_BIND=0.0.0.0
CLASH_API_SECRET=
# Leave unset for an open dashboard. Set any value to require login
DASHBOARD_PASSWORD=

# Cloudflare clean-edge manager (cf-edge-manager: discovery + selection + probe)
# Private fallback server host (must match xray-fallback/config.json).
FALLBACK_HOST=
# Pinned cfst release
CFST_VERSION=2.3.5
# cf-edge-manager image tag pulled on the client (discovery + selection + probe)
CF_MANAGER_VERSION=latest
# --- AUTOMATION SWITCHES (both off by default) ------------------------------
# Scheduled discovery scan. Empty = disabled (default). 6-field cron, leading
# SECONDS column; e.g. "0 0 5 * * 1" = Mondays 05:00. TZ sets what the hour means.
CF_SCAN_CRON=
# Timezone for CF_SCAN_CRON, e.g. America/New_York, Europe/London (default UTC).
TZ=UTC
# Master switch for ALL autonomous runtime behavior (the in-process picker: edge
# probing, quarantine, rewriting + restarting sni-spoofing-fallback). Off keeps
# the manager a pure on-demand scanner.
CF_SELECT_ENABLE=false

# --- REQUIRED wire/identity params (must match the live main xray "proxy"
# outbound + sni-spoofing, or the real-path probe reads as a false failure;
# see xray/config.json). Needed only once you set CF_SELECT_ENABLE=true. -------
CF_PROBE_UUID=
CF_PROBE_PATH=
CF_PROBE_ORIGIN_HOST=
CF_PROBE_FAKE_UTLS=firefox     # sni-spoofing decoy-hello uTLS fingerprint (match production)
CF_PROBE_REAL_UTLS=chrome      # xray real-hello uTLS fingerprint (match production)
CF_PROBE_FRAGMENT=false        # match production; A/B showed fragment-on is WORSE here
