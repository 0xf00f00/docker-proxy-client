UID=1000
GID=1000

PSIPHON_EGRESS_REGION=

MACVLAN_PARENT=eth0

NAIVE_SERVER=
NAIVE_USER=
NAIVE_PASSWORD=

FRP_PROXY_VERSION=v0.66.0
FRP_PROXY_SERVER_ADDR=
FRP_PROXY_AUTH_TOKEN=
FRP_PROXY_VISITOR_SK=

# GooseRelayVPN client pinned version
GOOSE_VERSION=v1.7.1

# SNI-spoofing client pinned version
SNI_SPOOFING_VERSION=0.5.1

BYEDPI_VERSION=v0.17.3
# byedpi desync args
BYEDPI_DESYNC=-s 1:5:3+s

SKIRK_VERSION=latest
# Paste the one-line `skirk:...` client profile from your exit node below.
SKIRK_CLIENT_CONFIG=
# Google Drive poll interval (ms): lower = snappier but more Drive ops.
SKIRK_POLL_MS=1000
# Skirk's "upload/download workers" = Drive concurrency. Leave 0 to let
# Skirk auto-profile (its "Recommended" 8 upload / 16 download).
SKIRK_UPLOAD_CONCURRENCY=0
SKIRK_DOWNLOAD_CONCURRENCY=0

PRIVATE_DNS_STAMP=

MDNS_VERSION=latest
MDNS_DOMAIN=
MDNS_ENCRYPTION_KEY=
# Encryption: 0=None, 1=XOR, 2=ChaCha20, 3=AES-128-GCM, 4=AES-192-GCM, 5=AES-256-GCM
MDNS_DATA_ENCRYPTION_METHOD=1
# MTU bounds the client searches between when probing each resolver.
# Lower = more resolvers pass / slower throughput. Higher = faster / more drops.
# Sample defaults are biased toward lossy/high-latency links (this is a last-resort tunnel).
MDNS_MIN_UPLOAD_MTU=38
MDNS_MAX_UPLOAD_MTU=150
MDNS_MIN_DOWNLOAD_MTU=200
MDNS_MAX_DOWNLOAD_MTU=4000

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_BIND=0.0.0.0
CLASH_API_SECRET=
# Leave unset for an open dashboard. Set any value to require login
DASHBOARD_PASSWORD=

# Cloudflare clean-edge scanner + fallback (cf-edge-scanner / cf-edge-picker)
# Private fallback server host (must match xray-fallback/config.json).
FALLBACK_HOST=
# Pinned cfst release
CFST_VERSION=2.3.5
# Scanner image tag pulled on the client
CF_SCANNER_VERSION=latest
# Host loopback port the dashboard uses to reach the scanner's control API.
CF_API_PORT=8088
# Low concurrency keeps the scan polite on a ~2 MB/s uplink -- raise with care.
CF_THREADS=5
CF_PING_COUNT=10
CF_LOSS_MAX=0.10
CF_LAT_MAX=1000
CF_POOL_SIZE=10
# Interactive single-IP tests run concurrently with a scan (their own lane).
CF_TEST_CONCURRENCY=3
# Skip a scan when NO upstream is reachable at all
CF_PREFLIGHT=true

CF_TLS_CHECK=0
CF_TLS_SNI=hcaptcha.com

CF_SCAN_TIMEOUT=21600
CF_TEST_TIMEOUT=180
# Weekly scan schedule (ofelia sidecar). NOTE: ofelia cron is 6-field with a
# leading SECONDS column -- default below = Mondays 05:00 local. Dashboard can
# still scan on demand. TZ (below) sets what the cron hour means.
CF_SCAN_CRON=0 0 5 * * 1
# Timezone for the scan schedule, e.g. America/New_York, Europe/London (default UTC)
TZ=UTC