UID=1000
GID=1000

PSIPHON_EGRESS_REGION=

MACVLAN_PARENT=eth0

NAIVE_SERVER=
NAIVE_USER=
NAIVE_PASSWORD=

FRP_PROXY_VERSION=v0.66.0
FRP_PROXY_SERVER_ADDR=
FRP_PROXY_AUTH_TOKEN=
FRP_PROXY_VISITOR_SK=

PRIVATE_DNS_STAMP=

DNSTT_DOMAIN=
DNSTT_PUBKEY=
# Fallback DNS server for dnstt (used if dns-scanner/out/active_dns.txt is empty)
DNSTT_RESOLVER=1.1.1.1:53
# Optional: use DNS-over-HTTPS (DoH) instead of raw UDP (uncomment to enable)
# DNSTT_DOH_URL=https://cloudflare-dns.com/dns-query
DNSTT_SSH_USER=tunnel
DNSTT_SOCKS_PORT=5080
# How often (seconds) to check for DNS updates in active_dns.txt (default 6h)
DNSTT_REFRESH_INTERVAL=21600