UID=1000
GID=1000
# Timezone for the dashboard's day boundaries and the scan schedule, e.g. America/New_York (default UTC)
TZ=UTC
MACVLAN_PARENT=eth0

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_BIND=0.0.0.0
# Leave empty for an open dashboard. Set any value to require login
DASHBOARD_PASSWORD=
# Clash control API token — REQUIRED. Generate a fresh one: `openssl rand -hex 32`
CLASH_API_SECRET=
# Per-host connection history (a 30-day per-domain tally on disk). OFF by default; deploy-time only.
CONNECTION_TRACKING=false
# Occasional tiny test probes, ~0.8 MB/day. `off` keeps the health monitor passive-only.
HEALTH_ACTIVE_PROBES=on

# Proxies
PSIPHON_EGRESS_REGION=
FRP_PROXY_SERVER_ADDR=
FRP_PROXY_AUTH_TOKEN=
FRP_PROXY_VISITOR_SK=
PRIVATE_DNS_STAMP=
# byedpi desync args
BYEDPI_DESYNC=-s 1:5:3+s
# Paste the one-line `skirk:...` client profile from your exit node
SKIRK_CLIENT_CONFIG=

# MasterDnsVPN
MDNS_DOMAIN=
MDNS_ENCRYPTION_KEY=
# 0=None, 1=XOR, 2=ChaCha20, 3=AES-128-GCM, 4=AES-192-GCM, 5=AES-256-GCM
MDNS_DATA_ENCRYPTION_METHOD=1
# DNS-scanner control API secret — REQUIRED. Generate a fresh one: `openssl rand -hex 32`
SCANNER_API_SECRET=
# Scheduled resolver scans (0 = on demand only)
SCANNER_AUTO_SCAN=0

# Cloudflare clean-edge manager. Nothing runs automatically until you turn a switch on.
# Private fallback server host (must match xray-fallback/config.json).
FALLBACK_HOST=
# Scheduled discovery scan
CF_SCAN_ENABLE=false
# 6-field cron with a leading SECONDS column, in TZ; empty = daily. e.g. "0 0 5 * * 1" = Mondays 05:00
CF_SCAN_CRON=
# Autonomous edge rotation: probes edges and rewrites + restarts sni-spoofing. Needs the three values below.
CF_SELECT_ENABLE=false
# Must match the live main xray "proxy" outbound (see xray/config.json), or every edge reads as failed.
CF_PROBE_UUID=
CF_PROBE_PATH=
CF_PROBE_ORIGIN_HOST=
