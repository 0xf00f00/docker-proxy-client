FRP_VERSION=v0.66.0
FRP_SERVER_ADDR=
FRP_SSH_REMOTE_PORT=
FRP_AUTH_TOKEN=

# Second relay, direct
FRP_SECONDARY_SERVER_ADDR=
FRP_SECONDARY_SSH_REMOTE_PORT=2280
FRP_SECONDARY_AUTH_TOKEN=

# psiphon: main relay via the psiphon container. Blank port = share FRP_SSH_REMOTE_PORT (active/standby);
# a separate port (must be in the relay's allowPorts) runs both routes at once.
FRP_PSIPHON_SSH_REMOTE_PORT=
FRP_PSIPHON_PROXY_URL=socks5://10.20.0.14:1080
