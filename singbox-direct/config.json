            "type": "socks",
            "tag": "socks-in",
            "listen": "::",
            "listen_port": 7891
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct",
            "bind_interface": "eth0"
        }
    ]
}