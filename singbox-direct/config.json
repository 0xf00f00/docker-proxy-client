{
    "log": {
        "level": "warn"
    },
    "dns": {
        "servers": [
            {
                "tag": "local_coredns",
                "address": "10.20.0.10",
                "detour": "direct"
            }
        ],
        "rules": [
            {
                "outbound": "any",
                "server": "local_coredns"
            }
        ]
    },
    "inbounds": [
