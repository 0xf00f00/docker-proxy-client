# MasterDnsVPN client config — rendered at container startup from env vars.
# Do NOT edit this file directly: changes are overwritten on every restart.
# - Tunnel identity (domain, key, cipher) and listen port come from .env
# - Resolver list is in client_resolvers.txt (editable via dashboard)
# Other knobs use the binary's built-in defaults.

# --- Tunnel identity & security ------------------------------------------------
DOMAINS = ["@@DOMAIN@@"]
DATA_ENCRYPTION_METHOD = @@DATA_ENCRYPTION_METHOD@@
ENCRYPTION_KEY = "@@ENCRYPTION_KEY@@"

# --- Local SOCKS5 proxy --------------------------------------------------------
PROTOCOL_TYPE = "SOCKS5"
LISTEN_IP = "0.0.0.0"
LISTEN_PORT = 18000
SOCKS5_AUTH = false

# --- Resolver runtime ----------------------------------------------------------
# Resolvers are loaded from client_resolvers.txt in the working directory.
RESOLVER_BALANCING_STRATEGY = 3
PACKET_DUPLICATION_COUNT = 3
SETUP_PACKET_DUPLICATION_COUNT = 4
RECHECK_INACTIVE_SERVERS_ENABLED = true
AUTO_DISABLE_TIMEOUT_SERVERS = true

# --- MTU discovery -------------------------------------------------------------
# Keep in sync with the bounds in dns-scanner/cmd/scanner/main.go.
MIN_UPLOAD_MTU = 38
MAX_UPLOAD_MTU = 150
MIN_DOWNLOAD_MTU = 200
MAX_DOWNLOAD_MTU = 4000
AUTO_REMOVE_LOW_MTU_SERVERS = true

# --- Logging -------------------------------------------------------------------
LOG_LEVEL = "INFO"
